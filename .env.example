# LedgerFlow settings. Copy to .env and fill in what you use (docs/GETTING_STARTED.md says when).
# In development (npm run dev) every secret below has a safe default, so a fresh checkout runs
# with only the Supabase lines filled in. In production the server refuses to start without
# SESSION_SECRET, SYSTEM_SALT and a database connection string.

# --- Your own Supabase project (Settings → API and Settings → Database in the Supabase dashboard)
# Local development without these uses an inert, unconfigured Supabase URL (guest mode only).
# Provide both for sign-in with your own development project. Production has separate defaults.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# the same project, for the server
SUPABASE_URL=
# the Postgres connection string (use the "Session pooler" string); the server reads and writes through it
DATABASE_URL=
# only for projects that still sign tokens with the legacy JWT secret (newer projects use signing keys)
SUPABASE_JWT_SECRET=
# for file attachments (Storage)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# --- Required in production (development uses built-in placeholders)
SESSION_SECRET=
SYSTEM_SALT=
INVITE_SECRET=
ENCRYPTION_SECRET=
# the address people open the app at (links in emails, payment pages)
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# protects the daily job endpoint (/api/cron/daily)
CRON_SECRET=

# --- Tests only: a plain local Postgres (never a Supabase database); see docs/GETTING_STARTED.md
LF_TEST_DATABASE_URL=

# --- Optional services: each feature says "not set up" until its keys are here
# email (one of them)
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=
# online payments and billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# bank feeds
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# AU-1: where Plaid sends "new transactions ready" notices, e.g. https://your-domain/api/webhook/plaid (optional)
PLAID_WEBHOOK_URL=
# AI suggestions
GEMINI_API_KEY=
# exchange rates and sales tax lookups
CURRENCY_API_KEY=
TAX_API_KEY=
# verifies the database's TLS certificate (paste the CA certificate)
DATABASE_CA_CERT=
ADMIN_ALERT_EMAIL=
