# Local development image (docker-compose.yml). Not used for production deploys.
FROM node:22-alpine
WORKDIR /app
COPY --chown=node:node package*.json ./
# No lifecycle scripts: the only one is the Husky git-hook installer, which a container does not need.
RUN npm ci --ignore-scripts && chown -R node:node /app
# The sources are not baked in: docker-compose.yml bind-mounts the checkout at /app, so nothing from the
# working tree (.env files included) is copied into the image.
USER node
EXPOSE 3000 5173
CMD ["npm", "run", "dev"]
