{
  "name": "ledgerflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "scripts": {
    "scaffold:plugin": "node scripts/scaffold.js plugin",
    "scaffold:algo": "node scripts/scaffold.js algo",
    "db:init": "node scripts/init-db.js",
    "grant-admin": "node scripts/grant-admin.js",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit && eslint .",
    "test": "NODE_ENV=test SYSTEM_SALT=test-ledgerflow-salt-32b-deterministic tsx --test src/tests/*.test.ts src/lib/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"tsx --test src/tests/rules/firestore.rules.test.ts\"",
    "verify": "npm ci --dry-run --ignore-scripts && npm run lint && npm test && npm run test:rules && npm audit --audit-level=high && npx playwright test",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "prepare": "husky",
    "test:cov": "NODE_ENV=test SYSTEM_SALT=test-ledgerflow-salt-32b-deterministic tsx --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-branches=65 src/tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.20.6",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "morgan": "^1.12.1",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pdfkit": "^0.20.2",
    "plaid": "^42.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.0.1",
    "react-plaid-link": "^4.1.1",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "recharts": "^2.15.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.2.0",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^4.0.0",
    "@playwright/test": "^1.63.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.0",
    "firebase-tools": "^15.30.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}