{
  "name": "ledgerflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "scaffold:plugin": "node scripts/scaffold.js plugin",
    "scaffold:algo": "node scripts/scaffold.js algo",
    "scaffold:report": "node scripts/scaffold.js report",
    "db:test-setup": "tsx scripts/db-test.ts setup",
    "grant-admin": "tsx scripts/grant-admin.ts",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "lint": "npm run lint:types; npm run lint:eslint",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint . --max-warnings 241",
    "test": "NODE_ENV=test SYSTEM_SALT=test-ledgerflow-salt-32b-deterministic tsx --test src/tests/*.test.ts src/tests/*.test.tsx src/lib/*.test.ts",
    "test:rules": "tsx scripts/db-test.ts rls",
    "test:e2e": "playwright test",
    "verify": "npm ci --dry-run --ignore-scripts && npm run lint && npm test && npm run test:rules && npm audit --audit-level=high && npm run test:e2e",
    "preview": "vite preview",
    "start": "node build/server.cjs",
    "prepare": "if [ \"$HUSKY\" != \"0\" ]; then husky; fi || true",
    "ratchet:update": "tsx scripts/update-ratchet.ts",
    "test:cov": "NODE_ENV=test SYSTEM_SALT=test-ledgerflow-salt-32b-deterministic tsx --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/tests/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-lines=75 --test-coverage-branches=72 --test-coverage-functions=73 src/tests/*.test.ts src/tests/*.test.tsx src/lib/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^8.20.6",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "bidi-js": "^1.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.1",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "plaid": "^42.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.0.1",
    "react-plaid-link": "^4.1.1",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.0.2",
    "vite": "^6.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "global-jsdom": "^26.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.60.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "csv-parse": "^7.0.2",
    "esbuild": "^0.28.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
