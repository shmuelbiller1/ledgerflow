+            bank connections and the audit trail are not in the server backup and so are not here.
+          </p>
+        </div>
+      )}
+
+      {!allowed && <p className="mt-2 text-xs text-[var(--muted)]">Workspace owner sign-in required.</p>}
+    </div>
+  );
+}
