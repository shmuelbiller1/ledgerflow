+
+  const download = async () => {
+    if (pending.current || !allowed || !plan) return;
+    const auth = useAuthStore.getState();
+    const selectedId = auth.currentWorkspaceId;
+    const user = auth.user;
+    if (!selectedId || !user) return;
+    pending.current = true;
+    setBusy(true);
