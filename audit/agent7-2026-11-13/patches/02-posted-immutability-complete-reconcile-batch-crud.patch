diff --git a/src/server/routes/transactions/postedImmutabilityGuard.ts b/src/server/routes/transactions/postedImmutabilityGuard.ts
new file mode 100644
index 000000000..2f913c081
--- /dev/null
+++ b/src/server/routes/transactions/postedImmutabilityGuard.ts
@@ -0,0 +1,140 @@
+import type { DocumentData } from '../../db/firestore';
+
+const POSTED_STATUSES = new Set([
+  'completed',
+  'reconciled',
+  'certified',
+  'approved',
+  'reviewed',
+]);
+
+const SYSTEM_METADATA_TYPES = new Set([
+  'invoice-posting',
+  'invoice-accrual',
+  'bill-posting',
+  'bill-accrual',
+  'payment',
+  'standalone-payment',
+  'payment-void',
+  'credit-note',
+  'vendor-credit',
+  'credit-refund',
+  'credit-application-fx',
+  'fx-revaluation',
+  'fx-revaluation-reversal',
+  'depreciation',
+  'depreciation-run',
+  'place-in-service',
+  'asset-disposal',
+  'prepaid-amortization',
+  'tax-adjustment',
+  'pay-run',
+  'payroll-import',
+  'stock-closing',
+  'stock-revaluation',
+  'bad-debt-writeoff',
+  'opening-balance',
+]);
+
+const DOCUMENT_ID_KEYS = [
+  'invoiceId',
+  'billId',
+  'paymentId',
+  'creditNoteId',
+  'vendorCreditId',
+  'depositId',
+  'payRunId',
+  'assetId',
+] as const;
+
+export function isSystemOrDocumentBacked(tx: DocumentData | undefined): boolean {
+  if (!tx) return false;
+  for (const k of DOCUMENT_ID_KEYS) {
+    if (tx[k]) return true;
+  }
+  const meta = (tx.metadata || {}) as Record<string, unknown>;
+  for (const k of DOCUMENT_ID_KEYS) {
+    if (meta[k]) return true;
+  }
+  if (typeof meta.type === 'string' && SYSTEM_METADATA_TYPES.has(meta.type)) return true;
+  if (tx.reversalOf || tx.reversalEventId || meta.isReversal) return true;
+  return false;
+}
+
+export function isPostedLedgerStatus(tx: DocumentData | undefined): boolean {
+  if (!tx) return false;
+  const status = String(tx.status || '').toLowerCase();
+  if (tx.type === 'forecast' || status === 'draft' || status === 'void') return false;
+  return POSTED_STATUSES.has(status) || Boolean(tx.reconciled || tx.isReconciled || tx.isCleared);
+}
+
+/**
+ * Enforces #652/#662 + A7N-03 across full updates, partial updates, batch updates, and bank reconciliation:
+ * posted, document-backed, or system-generated ledger entries cannot have their financial coordinates
+ * (`date`, `lines`, `amountCents`, `totalAmountCents`, `currency`, `originalCurrency`, `exchangeRate`, `type`),
+ * soft-delete state (`deletedAt`, `isDeleted`), or posted status demoted (`void`/`draft`/`failed`) in place.
+ */
+export function postedMutationViolation(
+  existing: DocumentData | undefined,
+  incoming: Record<string, unknown>,
+  mode: 'full' | 'partial' | 'batch' | 'reconcile',
+): string | null {
+  if (!existing) return null;
+  const docOrSystem = isSystemOrDocumentBacked(existing);
+  const posted = isPostedLedgerStatus(existing);
+  if (!docOrSystem && !posted) return null;
+
+  if (incoming.deletedAt !== undefined || incoming.isDeleted === true) {
+    return 'Posted or document-backed ledger entries cannot be soft-deleted; post a reversing entry instead.';
+  }
+
+  if (incoming.status !== undefined) {
+    const nextStatus = String(incoming.status);
+    if (nextStatus === 'void' || nextStatus === 'draft' || nextStatus === 'failed') {
+      return `Posted or system ledger entries cannot be changed to '${nextStatus}' in place; reverse the entry or source document instead.`;
+    }
+  }
+
+  const touchesCurrencyOrRate =
+    (incoming.currency !== undefined && incoming.currency !== existing.currency) ||
+    (incoming.originalCurrency !== undefined && incoming.originalCurrency !== existing.originalCurrency) ||
+    (incoming.exchangeRate !== undefined && incoming.exchangeRate !== (existing.exchangeRate ?? 1));
+  if (touchesCurrencyOrRate) {
+    return 'Posted ledger entries cannot change currency or exchange rate in place; use Reverse & Correct.';
+  }
+
+  if (incoming.date !== undefined && String(incoming.date) !== String(existing.date || '')) {
+    return 'Posted ledger entries cannot change transaction date in place; use Reverse & Correct.';
+  }
+
+  if (incoming.type !== undefined && incoming.type !== existing.type) {
+    return 'Posted ledger entries cannot change entry type in place.';
+  }
+
+  if (incoming.totalAmountCents !== undefined && Number(incoming.totalAmountCents) !== Number(existing.totalAmountCents)) {
+    return 'Posted ledger entries cannot change total amount in place; use Reverse & Correct.';
+  }
+
+  if (incoming.lines !== undefined) {
+    if (docOrSystem || mode === 'reconcile') {
+      return 'System or document-backed ledger entries cannot have their lines rewritten; reverse or void the source document instead.';
+    }
+    const oldLines = Array.isArray(existing.lines) ? existing.lines : [];
+    const newLines = Array.isArray(incoming.lines) ? incoming.lines as Array<Record<string, unknown>> : [];
+    if (oldLines.length !== newLines.length) {
+      return 'Posted ledger entries cannot add or remove split lines in place; use Reverse & Correct.';
+    }
+    for (let i = 0; i < oldLines.length; i++) {
+      const a = oldLines[i] as Record<string, unknown>;
+      const b = newLines[i];
+      if (Number(a.amountCents) !== Number(b.amountCents) || (a.exchangeRate ?? 1) !== (b.exchangeRate ?? 1)) {
+        return 'Posted ledger entries cannot change line amounts or exchange rates in place; use Reverse & Correct.';
+      }
+      if (docOrSystem && String(a.accountId) !== String(b.accountId)) {
+        return 'Document-backed ledger entries cannot change accounts in place.';
+      }
+    }
+  }
+
+  return null;
+}
