+
+attachmentRouter.post('/:attachmentId/link', async (req, res) => {
+  const { workspaceId, attachmentId } = req.params as Record<string, string>;
+  const { user, userRole } = req as unknown as AuthedRequest;
+  const transactionId = typeof req.body?.transactionId === 'string' ? req.body.transactionId.trim() : '';
+  if (!transactionId) return res.status(400).json({ status: 'error', message: 'Name the ledger entry to link' });
+  try {
+    const db = getDb();
+    const docRef = db.collection('documents').doc(attachmentId);
+    const txRef = db.collection('transactions').doc(transactionId);
+    const outcome = await db.runTransaction(async t => {
+      const [docSnap, txSnap] = await t.getAll(docRef, txRef);
+      const file = docSnap.exists ? docSnap.data() as { uid?: string; workspaceId?: string; name?: string } : undefined;
+      if (!file || file.workspaceId !== workspaceId) return 'missing' as const;
+      if (!mayRemoveAttachment(userRole, user.uid, { uid: String(file.uid || '') })) return 'forbidden' as const;
+      const entry = txSnap.exists ? txSnap.data() as { workspaceId?: string; status?: string; date?: string } : undefined;
+      // the evidence never points at another workspace's books, and never at something unposted
+      if (!entry || entry.workspaceId !== workspaceId) return 'entry-missing' as const;
+      if (entry.status === 'void' || entry.status === 'draft') return 'entry-unposted' as const;
+      t.update(docRef, { linkedTransactionId: transactionId, updatedAt: new Date().toISOString() });
+      await writeServerAuditLog({
+        workspaceId, uid: user.uid, email: user.email, action: 'attachment.linked',
+        entityType: 'transactions', entityId: transactionId,
+        details: { description: `Linked the file "${file.name || attachmentId}" to entry ${transactionId}`, attachmentId },
+      }, { db, tx: t });
+      return 'linked' as const;
+    });
+    if (outcome === 'missing') return res.status(404).json({ status: 'error', message: 'That file is not in this workspace' });
+    if (outcome === 'forbidden') return res.status(403).json({ status: 'error', message: 'Only the person who added it, or an owner, accountant or bookkeeper, can link it' });
+    if (outcome === 'entry-missing') return res.status(404).json({ status: 'error', message: 'That ledger entry is not in this workspace' });
+    if (outcome === 'entry-unposted') return res.status(409).json({ status: 'error', message: 'A file cannot be the evidence for a draft or void entry' });
+    res.json({ status: 'success', transactionId });
+  } catch (err) {
+    res.status(500).json({ status: 'error', message: 'The file could not be linked', details: err instanceof Error ? err.message : String(err) });
+  }
+});
diff --git a/supabase/migrations/20261116120000_document_link_tickets_and_pay_visibility.sql b/supabase/migrations/20261116120000_document_link_tickets_and_pay_visibility.sql
new file mode 100644
index 00000000..14e72e0c
--- /dev/null
+++ b/supabase/migrations/20261116120000_document_link_tickets_and_pay_visibility.sql
@@ -0,0 +1,119 @@
+-- A7S-03 (+ the ledger link of A7S-04): the two rules that let a workspace member read or rewrite what
+-- the screen never shows them — other people's support tickets, and the ledger link of a file.
+--
+-- 1. public.documents: linkedTransactionId is what makes a file the evidence for a posted entry, and it
+--    is written by the browser (own_update: any member, viewers included; Vault's link write, and before
+--    this migration an allowlist field). lf_documents_kind_guard (20261116000000) already refuses a
+--    client change to kind/sets/lines/status/paidRunId by comparing the old and the new row — the same
+--    comparison is extended here to linkedTransactionId. The attachment links (linkedCollection,
+--    linkedId, linkedLabel) stay writable, because uploading a file already writes them and the snap
+--    receipt links a photo to the bill it just created; only the pointer to a ledger entry moves.
+--    The write that sets it moves behind a writer role: POST /workspaces/:id/attachments/:id/link
+--    (attachmentRoutes.ts, in this patch), which refuses an entry of another workspace and needs
+--    lf_can_write — Vault's own 'link this receipt to the entry I just posted' call uses it.
+-- 2. public.supportTickets: ticket_read and ticket_update let every member of the workspace read and
+--    change every ticket. Both are narrowed to the person's own ticket (platform admins keep all).
+-- 3. public.employees: member_read lets a viewer select every employee row, including salaryCents,
+--    hourlyRateCents, preTaxDeductionsCents and the bank routing/account used for ACH. The isolation
+--    suite (supabase/tests/rls.test.sql) asserts that a viewer CAN read an employee row, so narrowing
+--    that policy is a product decision, not a hardening patch: this migration only adds the directory
+--    view a screen could use for that, without pay or bank details. The policy narrowing itself is
+--    written down (not applied) in audit/agent7-2026-11-16/03-RESERVED-LANE-FINDINGS.md.
+--
+-- Idempotent: the function is created or replaced, every policy and view is dropped before it is
+-- created, and the allowlist edits use array_remove, so a rerun neither fails nor needs the old value.
+
+-- ---------------------------------------------------------------------------
+-- 1. Documents: the ledger link is not a client field
+-- ---------------------------------------------------------------------------
+-- create or replace, so the keys 20261116000000 introduced stay forbidden exactly as they are.
+create or replace function public.lf_documents_kind_guard() returns trigger
+language plpgsql set search_path = ''
+as $$
+declare
+  forbidden_keys text[] := array[
+    'kind', 'sets', 'record', 'stage', 'lines', 'assignee', 'dueDate',
+    'paidRunId', 'hours', 'minutes', 'person', 'billable', 'invoiceId',
+    'employeeId', 'rateCents', 'status'
+  ];
+  -- the pointer to a ledger entry: changing it moves the evidence from one entry to another
+  ledger_link_keys text[] := array['linkedTransactionId'];
+  k text;
+begin
+  if public.lf_is_client() then
+    if tg_op = 'UPDATE' and coalesce(old.data->>'kind', '') <> '' then
+      raise exception 'Server-managed document records (%) can only be changed through the server', old.data->>'kind'
+        using errcode = '42501';
+    end if;
+    if coalesce(new.data->>'kind', '') <> '' then
+      raise exception 'Server-managed document records (%) can only be created through the server', new.data->>'kind'
+        using errcode = '42501';
+    end if;
+    foreach k in array forbidden_keys loop
+      if tg_op = 'INSERT' and (new.data ? k) and new.data->k is not null then
+        raise exception 'Field "%" on documents is managed by the server', k
+          using errcode = '42501';
+      end if;
+      if tg_op = 'UPDATE' and (new.data->k is distinct from old.data->k) then
+        raise exception 'Field "%" on documents is managed by the server', k
+          using errcode = '42501';
+      end if;
+    end loop;
+    -- the ledger link may be set when the file is uploaded, never changed afterwards
+    foreach k in array ledger_link_keys loop
+      if tg_op = 'UPDATE' and (new.data->k is distinct from old.data->k) then
+        raise exception 'The ledger link (%) of a document is set through the server (POST /attachments/:id/link)', k
+          using errcode = '42501';
+      end if;
+    end loop;
+  end if;
+  return new;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 2. Support tickets: the person's own ticket
+-- ---------------------------------------------------------------------------
+drop policy if exists ticket_read on public."supportTickets";
+create policy ticket_read on public."supportTickets" for select to authenticated
+  using (public.lf_is_platform_admin() or data->>'uid' = public.lf_uid());
+
+-- unreadForAdmin, lastMessageBy, errorLogId and errorDiagnostics stay on the allowlist: lf_enforce_rules
+-- checks every key of the new row, and SupportView still writes all four when a ticket is opened or
+-- answered. With the two policies above a client can only set them on its own ticket. Taking them off
+-- the allowlist waits for the server route that opens and answers tickets.
+
+-- a client may open its own ticket and close it; who it belongs to and when it was opened never move
+-- each key is added once, so a rerun changes nothing
+update public.lf_rules
+   set immutable_keys = array(
+         select distinct k
+           from unnest(coalesce(immutable_keys, '{}') || array['uid', 'workspaceId', 'createdAt']) as k
+          order by k)
+ where table_name = 'supportTickets';
+
+drop policy if exists ticket_update on public."supportTickets";
+create policy ticket_update on public."supportTickets" for update to authenticated
+  using (public.lf_is_platform_admin() or data->>'uid' = public.lf_uid())
+  with check (public.lf_is_platform_admin() or data->>'uid' = public.lf_uid());
+
+-- ---------------------------------------------------------------------------
+-- 3. Employees: a directory view for every member, with no pay or bank details
+-- ---------------------------------------------------------------------------
+-- Additive only: employee read keeps its current scope (a viewer may read a row), so nothing that works
+-- today stops working. A screen that only needs the directory can read this view instead, and the day
+-- the row policy is narrowed (see the findings document) it already exists.
+drop view if exists public.lf_employee_directory;
+create view public.lf_employee_directory as
+  select e.id,
+         e.workspace_id,
+         e.updated_at,
+         e.data - 'salaryCents' - 'hourlyRateCents' - 'payRateCents' - 'preTaxDeductionsCents'
+                - 'deductions' - 'bankRouting' - 'bankAccount' - 'bankAccountType'
+                - 'ssn' - 'taxId' as data
+    from public.employees e
+   where public.lf_is_member(e.workspace_id);
+
+comment on view public.lf_employee_directory is
+  'The employee directory every member may read: no pay, deductions, tax ids or bank instructions.';
+grant select on public.lf_employee_directory to authenticated;
