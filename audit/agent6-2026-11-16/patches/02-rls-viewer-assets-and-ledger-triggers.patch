diff --git a/supabase/migrations/20261116120000_rls_viewer_assets_and_ledger_triggers.sql b/supabase/migrations/20261116120000_rls_viewer_assets_and_ledger_triggers.sql
new file mode 100644
index 0000000..768d0cd
--- /dev/null
+++ b/supabase/migrations/20261116120000_rls_viewer_assets_and_ledger_triggers.sql
@@ -0,0 +1,181 @@
+-- Agent #6 (2026-11-16) — Consolidated RLS, Asset Accounting Guard, and Double-Entry DB Trigger Hardening
+-- Covers:
+--   1. SEC-NEW-04: Restrict public.documents (`own_insert`, `own_update`) to writer roles (`lf_can_write`)
+--      so read-only `viewer` users cannot insert/modify billable time or task records, and restrict
+--      public."supportTickets" (`ticket_update`) to ticket author, workspace admin/owner, or platform admin.
+--   2. A7N-06: Guard server-managed accounting state on public.assets (`accumulatedDepreciationCents`,
+--      `depreciatedThrough`, `lastDepreciationTransactionId`, `placedInService`, `disposedOn`,
+--      `disposalProceedsCents`, `disposalGainLossCents`, `disposalTransactionId`) against direct
+--      authenticated client tampering, and lock depreciable basis once depreciation/service has posted.
+--   3. A6-SQL-07: Enforce double-entry (`SUM(amountCents) = 0`) and all-or-none settled home-currency
+--      balance (`SUM(baseAmountCents) = 0`) at the PostgreSQL trigger layer on public.transactions.
+
+-- 1. SEC-NEW-04: Close viewer write surfaces on public.documents and public."supportTickets"
+drop policy if exists own_insert on public.documents;
+create policy own_insert on public.documents for insert to authenticated
+  with check (
+    (data->>'uid') = public.lf_uid()
+    and public.lf_can_write(workspace_id)
+  );
+
+drop policy if exists own_update on public.documents;
+create policy own_update on public.documents for update to authenticated
+  using (
+    (data->>'uid') = public.lf_uid()
+    and public.lf_can_write(workspace_id)
+  )
+  with check (
+    (data->>'uid') = public.lf_uid()
+    and public.lf_can_write(workspace_id)
+  );
+
+drop policy if exists ticket_update on public."supportTickets";
+create policy ticket_update on public."supportTickets" for update to authenticated
+  using (
+    public.lf_is_platform_admin()
+    or public.lf_can_admin(workspace_id)
+    or ((data->>'uid') = public.lf_uid() and public.lf_is_member(workspace_id))
+  )
+  with check (
+    public.lf_is_platform_admin()
+    or public.lf_can_admin(workspace_id)
+    or ((data->>'uid') = public.lf_uid() and public.lf_is_member(workspace_id))
+  );
+
+-- 2. A7N-06: Guard server-managed depreciation and disposal fields on public.assets
+create or replace function public.lf_asset_accounting_guard() returns trigger
+language plpgsql security definer set search_path = public
+as $$
+declare
+  has_posted_activity boolean;
+begin
+  if not public.lf_is_client() then
+    return coalesce(new, old);
+  end if;
+
+  if tg_op = 'INSERT' then
+    if coalesce((new.data->>'accumulatedDepreciationCents')::numeric, 0) <> 0
+       or new.data ? 'depreciatedThrough'
+       or new.data ? 'lastDepreciationTransactionId'
+       or new.data ? 'disposedOn'
+       or new.data ? 'disposalProceedsCents'
+       or new.data ? 'disposalGainLossCents'
+       or new.data ? 'disposalTransactionId'
+       or new.data ? 'placedInService'
+       or coalesce(new.data->>'status', 'active') = 'disposed' then
+      raise exception 'Fixed-asset depreciation and disposal fields are managed only by the server ledger'
+        using errcode = '42501';
+    end if;
+    return new;
+  elsif tg_op = 'UPDATE' then
+    if (new.data->>'accumulatedDepreciationCents') is distinct from (old.data->>'accumulatedDepreciationCents')
+       or (new.data->>'depreciatedThrough') is distinct from (old.data->>'depreciatedThrough')
+       or (new.data->>'lastDepreciationTransactionId') is distinct from (old.data->>'lastDepreciationTransactionId')
+       or (new.data->>'disposedOn') is distinct from (old.data->>'disposedOn')
+       or (new.data->>'disposalProceedsCents') is distinct from (old.data->>'disposalProceedsCents')
+       or (new.data->>'disposalGainLossCents') is distinct from (old.data->>'disposalGainLossCents')
+       or (new.data->>'disposalTransactionId') is distinct from (old.data->>'disposalTransactionId')
+       or (new.data->'placedInService') is distinct from (old.data->'placedInService')
+       or (coalesce(new.data->>'status', '') = 'disposed' and coalesce(old.data->>'status', '') <> 'disposed') then
+      raise exception 'Fixed-asset depreciation and disposal fields are managed only by the server ledger'
+        using errcode = '42501';
+    end if;
+
+    has_posted_activity := coalesce((old.data->>'accumulatedDepreciationCents')::numeric, 0) > 0
+                           or old.data ? 'lastDepreciationTransactionId'
+                           or old.data ? 'placedInService'
+                           or old.data ? 'disposalTransactionId'
+                           or coalesce(old.data->>'status', '') = 'disposed';
+    if has_posted_activity and (
+       (new.data->>'purchasePriceCents') is distinct from (old.data->>'purchasePriceCents')
+       or (new.data->>'salvageValueCents') is distinct from (old.data->>'salvageValueCents')
+       or (new.data->>'usefulLifeYears') is distinct from (old.data->>'usefulLifeYears')
+       or (new.data->>'depreciationMethod') is distinct from (old.data->>'depreciationMethod')
+       or (new.data->>'purchaseDate') is distinct from (old.data->>'purchaseDate')
+    ) then
+      raise exception 'Depreciable basis cannot be modified directly after asset postings exist'
+        using errcode = '42501';
+    end if;
+    return new;
+  elsif tg_op = 'DELETE' then
+    if coalesce((old.data->>'accumulatedDepreciationCents')::numeric, 0) > 0
+       or old.data ? 'lastDepreciationTransactionId'
+       or old.data ? 'placedInService'
+       or old.data ? 'disposalTransactionId'
+       or coalesce(old.data->>'status', '') = 'disposed' then
+      raise exception 'Assets with posted ledger activity cannot be deleted directly'
+        using errcode = '42501';
+    end if;
+    return old;
+  end if;
+
+  return coalesce(new, old);
+end $$;
+
+drop trigger if exists lf_asset_accounting_guard_trg on public."assets";
+create trigger lf_asset_accounting_guard_trg
+  before insert or update or delete on public."assets"
+  for each row execute function public.lf_asset_accounting_guard();
+
+-- 3. A6-SQL-07: Enforce double-entry and all-or-none home-currency balance on public.transactions
+create or replace function public.lf_enforce_transaction_double_entry() returns trigger
+language plpgsql security definer set search_path = public
+as $$
+declare
+  tx_status text := coalesce(new.data->>'status', 'completed');
+  lines_json jsonb := new.data->'lines';
+  line_count int;
+  net_amount numeric := 0;
+  base_count int := 0;
+  net_base numeric := 0;
+begin
+  if tx_status in ('draft', 'void', 'failed') or (new.data ? 'deletedAt' and new.data->>'deletedAt' is not null) then
+    return new;
+  end if;
+  if coalesce((new.data->'metadata'->>'isGhost')::boolean, false) or coalesce(new.data->>'type', '') = 'forecast' then
+    return new;
+  end if;
+  if jsonb_typeof(lines_json) <> 'array' then
+    return new;
+  end if;
+  line_count := jsonb_array_length(lines_json);
+  if line_count = 0 then
+    return new;
+  end if;
+
+  select
+    coalesce(sum((elem->>'amountCents')::numeric), 0),
+    count(*) filter (where elem ? 'baseAmountCents' and elem->'baseAmountCents' <> 'null'::jsonb),
+    coalesce(sum((elem->>'baseAmountCents')::numeric) filter (where elem ? 'baseAmountCents' and elem->'baseAmountCents' <> 'null'::jsonb), 0)
+  into net_amount, base_count, net_base
+  from jsonb_array_elements(lines_json) as elem;
+
+  if net_amount <> 0 then
+    raise exception 'Ledger double-entry violation: transaction lines sum to % minor units (must equal 0)', net_amount
+      using errcode = '23514';
+  end if;
+
+  if base_count > 0 and base_count < line_count then
+    raise exception 'Ledger home-currency violation: baseAmountCents must be present on all lines or none'
+      using errcode = '23514';
+  end if;
+
+  if base_count = line_count and net_base <> 0 then
+    raise exception 'Ledger home-currency violation: baseAmountCents lines sum to % minor units (must equal 0)', net_base
+      using errcode = '23514';
+  end if;
+
+  return new;
+end $$;
+
+drop trigger if exists lf_enforce_transaction_double_entry_trg on public."transactions";
+create trigger lf_enforce_transaction_double_entry_trg
+  before insert or update on public."transactions"
+  for each row execute function public.lf_enforce_transaction_double_entry();
+
+update public.lf_rules
+   set date_required = true
+ where table_name in ('invoices', 'bills', 'creditNotes', 'vendorCredits');
+
+drop trigger if exists trg_transactions_period_lock on public."transactions";
+drop trigger if exists trg_transactions_posted_immutability on public."transactions";
