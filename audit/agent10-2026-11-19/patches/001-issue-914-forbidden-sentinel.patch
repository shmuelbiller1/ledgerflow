diff --git a/src/server/utils/errorStatus.ts b/src/server/utils/errorStatus.ts
new file mode 100644
index 0000000..1b277ef
--- /dev/null
+++ b/src/server/utils/errorStatus.ts
@@ -0,0 +1,49 @@
+import { errorMessage } from '../auth/requestUser';
+
+/**
+ * Route-level error mapping (issue #914).
+ *
+ * The command layer refuses with an error whose message is `CODE: human sentence` — see
+ * `CommandRefusal` in `utils/commandExecutor.ts` and `src/server/http/serverKit.ts`, which throw
+ * `FORBIDDEN: This workspace is administratively suspended…` and `PAYMENT_REQUIRED: …`. Routes that
+ * compare the whole message with `=== 'FORBIDDEN'` therefore never match, so an authorization
+ * refusal reaches the client as `500 An internal server error occurred.` (and pollutes the 5xx
+ * alerts) instead of 403.
+ *
+ * Compare the *code*, i.e. the leading token up to the first `:` or space, not the sentence.
+ */
+export function hasErrorCode(message: string | undefined | null, code: string): boolean {
+  if (!message) return false;
+  const text = message.trim();
+  if (text === code) return true;
+  if (!text.startsWith(code)) return false;
+  const next = text.charAt(code.length);
+  return next === ':' || next === ' ' || next === '-' || next === '(';
+}
+
+export function isForbiddenError(err: unknown): boolean {
+  return hasErrorCode(errorMessage(err), 'FORBIDDEN');
+}
+
+export function isNotFoundError(err: unknown): boolean {
+  return hasErrorCode(errorMessage(err), 'NOT_FOUND');
+}
+
+export function isPaymentRequiredError(err: unknown): boolean {
+  return hasErrorCode(errorMessage(err), 'PAYMENT_REQUIRED');
+}
+
+/**
+ * The HTTP status an error carries, if the command layer attached one (`CommandRefusal.status`),
+ * otherwise the status implied by its code, otherwise `undefined` so the caller keeps its own default.
+ */
+export function statusForError(err: unknown): number | undefined {
+  const explicit = Number((err as { status?: unknown } | null)?.status);
+  if (Number.isFinite(explicit) && explicit >= 400 && explicit <= 599) return explicit;
+  const message = errorMessage(err);
+  if (hasErrorCode(message, 'FORBIDDEN')) return 403;
+  if (hasErrorCode(message, 'NOT_FOUND')) return 404;
+  if (hasErrorCode(message, 'PAYMENT_REQUIRED')) return 402;
+  if (hasErrorCode(message, 'CONFLICT')) return 409;
+  return undefined;
+}
diff --git a/src/tests/agent10-error-status.test.ts b/src/tests/agent10-error-status.test.ts
new file mode 100644
index 0000000..ca9cc6a
--- /dev/null
+++ b/src/tests/agent10-error-status.test.ts
@@ -0,0 +1,70 @@
+/**
+ * #914 — routes returned 500 instead of 403/402 because they compared the whole error message with
+ * a code sentinel. The command layer refuses with `FORBIDDEN: human sentence`
+ * (`CommandRefusal`, `serverKit`), so `errorMessage(err) === 'FORBIDDEN'` never matched.
+ */
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import path from 'node:path';
+import { hasErrorCode, isForbiddenError, isNotFoundError, isPaymentRequiredError, statusForError } from '../server/utils/errorStatus';
+
+describe('hasErrorCode', () => {
+  it('accepts the bare code and the "CODE: sentence" form the command layer throws', () => {
+    assert.equal(hasErrorCode('FORBIDDEN', 'FORBIDDEN'), true);
+    assert.equal(hasErrorCode('FORBIDDEN: your role in this workspace is read-only.', 'FORBIDDEN'), true);
+    assert.equal(hasErrorCode('  FORBIDDEN: requires the owner role.  ', 'FORBIDDEN'), true);
+    assert.equal(hasErrorCode('PAYMENT_REQUIRED: exhausted compute credit', 'PAYMENT_REQUIRED'), true);
+  });
+
+  it('does not match a longer word that merely starts with the code, or a sentence that contains it', () => {
+    assert.equal(hasErrorCode('FORBIDDENLY yours', 'FORBIDDEN'), false);
+    assert.equal(hasErrorCode('Could not read FORBIDDEN column', 'FORBIDDEN'), false);
+    assert.equal(hasErrorCode('', 'FORBIDDEN'), false);
+    assert.equal(hasErrorCode(undefined, 'FORBIDDEN'), false);
+  });
+
+  it('classifies the three codes routes care about', () => {
+    assert.equal(isForbiddenError(new Error('FORBIDDEN: not a member of this workspace')), true);
+    assert.equal(isForbiddenError(new Error('NOT_FOUND: workspace')), false);
+    assert.equal(isNotFoundError(new Error('NOT_FOUND: workspace')), true);
+    assert.equal(isPaymentRequiredError(new Error('PAYMENT_REQUIRED: no seat left')), true);
+  });
+
+  it('maps a code to the HTTP status the route should send, and leaves unknown errors alone', () => {
+    assert.equal(statusForError(new Error('FORBIDDEN: read-only')), 403);
+    assert.equal(statusForError(new Error('NOT_FOUND: workspace')), 404);
+    assert.equal(statusForError(new Error('PAYMENT_REQUIRED: credit')), 402);
+    assert.equal(statusForError(new Error('QUOTA_EXCEEDED: rows')), undefined);
+    assert.equal(statusForError({ status: 409, message: 'conflict' }), 409, 'an explicit status wins');
+    assert.equal(statusForError({ status: 200 }), undefined, 'a nonsense status is ignored');
+  });
+});
+
+/** Walk src/server/routes and assert no route still compares a whole message with a code sentinel. */
+function routeFiles(dir: string, out: string[] = []): string[] {
+  for (const entry of readdirSync(dir)) {
+    const full = path.join(dir, entry);
+    if (statSync(full).isDirectory()) routeFiles(full, out);
+    else if (full.endsWith('.ts') && !full.endsWith('.test.ts')) out.push(full);
+  }
+  return out;
+}
+
+describe('#914 regression guard', () => {
+  it('no route compares an error message with a code sentinel by equality', () => {
+    const bad: string[] = [];
+    // Equality alone is the defect: a line that also tests the code with includes/startsWith/regex
+    // (as the NOT_FOUND sites do) still works, so only pure equality is flagged.
+    const equality = /===\s*["'](FORBIDDEN|PAYMENT_REQUIRED|NOT_FOUND|CONFLICT|UNAUTHORIZED)["']/;
+    const fallback = /\.includes\(|\.startsWith\(|\.test\(/;
+    for (const file of routeFiles(path.join(process.cwd(), 'src/server/routes'))) {
+      readFileSync(file, 'utf8').split('\n').forEach((line, index) => {
+        if (equality.test(line) && !fallback.test(line)) {
+          bad.push(`${path.relative(process.cwd(), file)}:${index + 1} ${line.trim()}`);
+        }
+      });
+    }
+    assert.deepEqual(bad, [], 'use hasErrorCode/isForbiddenError (src/server/utils/errorStatus) instead');
+  });
+});
